{
  "name": "@gorban/dsh-job-stop",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: stop a running background job from the session-header job list, behind a confirmation dialog.",
  "license": "MIT",
  "author": {
    "name": "David Bruck",
    "url": "https://github.com/gorban"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "background-jobs",
    "jobs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorban/dsh-job-stop.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "tsdown",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-jobs": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  }
}
