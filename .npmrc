# This plugin runs inside a dsh profile, which provides every peer: the harness
# packages, React, and the browser platform modules. They are declared in
# package.json as optional peers so the runtime contract is documented, and this
# keeps a standalone `pnpm install` from trying to fetch harness packages — some
# of whose published rc builds depend on `@deepseek-ai/dsh-type-meta`, which is
# not on the public registry.
auto-install-peers=false
strict-peer-dependencies=false
